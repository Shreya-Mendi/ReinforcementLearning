# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Supabase (stretch goal)
# If set, all preference records are saved to your Supabase `preferences` table in real time.
# Without this, data lives in the Streamlit session and can be exported as CSV/JSONL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
